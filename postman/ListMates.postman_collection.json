          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/greeting",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "greeting"
              ]
            }
          }
        }
      ]
